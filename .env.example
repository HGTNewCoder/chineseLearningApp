# Copy to .env.local (never commit real values) or set these in your host's dashboard.
# Every variable is optional: without them the app runs local-only with no tracking.

# Cloud accounts + sync (Supabase → Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Error reporting (Sentry → Project Settings → Client Keys)
VITE_SENTRY_DSN=

# Cookie-free page analytics (the domain you registered in Plausible)
VITE_PLAUSIBLE_DOMAIN=
